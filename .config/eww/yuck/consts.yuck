; (deflisten notifs :initial "" `python ~/.config/eww/scripts/notifs.py`)
(defpoll weather         :interval "1h" `scripts/weather.sh`)
; (defpoll notes           :interval "10s" `cat ~/Documents/Obsidian-Vault/todo.md`)
(defpoll playerctl       :interval "2s" :initial '{"status": "Stopped"}' `bash ~/.config/eww/scripts/playerctl.sh`)
(defpoll activewindow    :interval "2s" `hyprctl activewindow -j`)

; (defpoll speaker-volume :interval "2s" `pactl get-sink-volume @DEFAULT_SINK@  | awk -F'/' '{print $2}' | sed 's/%//g' | xargs`)
; (defpoll mic-volume :interval "2s" `pactl get-sink-volume @DEFAULT_SOURCE@  | awk -F'/' '{print $2}' | sed 's/%//g' | xargs`)
     
(defvar speaker-volume 100)
(defvar mic-volume 100)
(defvar brightness 100)
(defvar kbbrightness 100)
(defvar glow-value 0.5)
(defvar scroll-sensitivity 0.2)

(defvar wifilist `[]`)
(defvar user "soilad")
(defvar pc "wowbigredsquarething")
(defvar reveal-transition "slidedown")  ;; dropdown popups
(defvar bar-transition    "slideright") ;; weather / player in the top bar
(defvar reveal-duration   "250ms")
(defvar format-time '%l:%M:%S %p')
(defvar format-date "%-dth %B, %Y")

(deflisten cava :interval "0s" `bash ~/.config/eww/scripts/cava.sh 4`)

(defvar reveal-status false)
(defvar reveal-search false)
(defvar reveal-wifi   false)
(defvar reveal-volume false)
(defvar reveal-barclock false)

(defvar height 48)
(defvar power-spacing 10)
(defvar side-spacing 10)
(defvar search-spacing 20)
(defvar cap 48)
(defvar circular-thickness 2)
(defvar player-button-spacing 5)
(defvar player-text-spacing 5)
(defvar weather-spacing 100)

